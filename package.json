{
  "name": "pico8-web-player-workspace",
  "version": "0.2.0-alpha.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "10.8.0"
  },
  "scripts": {
    "build": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "generate:host-bindings": "node tools/wasm/generate-host-bindings.mjs",
    "build:wasm": "pnpm run generate:host-bindings && node tools/wasm/build.mjs",
    "build:release": "pnpm run build && node tools/release/build-release.mjs",
    "pack:release": "node tools/release/pack-release.mjs",
    "test": "pnpm run verify",
    "test:architecture": "pnpm run build && node --test tests/architecture/*.test.mjs",
    "test:public-exports": "pnpm run build && tsc -p tests/architecture/consumer/tsconfig.json --pretty false",
    "test:runtime": "pnpm run build && node --test tests/runtime/*.test.mjs",
    "test:browser": "pnpm run build:release && node tools/browser/run.mjs",
    "verify": "pnpm run generate:host-bindings && pnpm run build && node --test tests/architecture/*.test.mjs tests/cart-codec/*.test.mjs tests/runtime/*.test.mjs tests/tools/*.test.mjs && node tools/cart-codec/verify-manifest.mjs && pnpm run verify:wasm",
    "verify:wasm": "node tools/wasm/verify-source.mjs && node tools/wasm/verify-runtime-manifest.mjs",
    "verify:release": "pnpm run build:release && node tools/release/verify-release.mjs && node --test tests/artifact/*.test.mjs",
    "test:wasm:repro": "node tools/wasm/reproducibility.mjs",
    "gallery": "node tools/local-gallery/server.mjs",
    "publish:pages": "pnpm run build:release && node tools/release/publish-pages.mjs"
  },
  "devDependencies": {
    "@babel/parser": "8.0.4",
    "@pico8-web/cart-codec": "workspace:*",
    "@pico8-web/contracts": "workspace:*",
    "@pico8-web/runtime-core": "workspace:*",
    "@pico8-web/z8lua-bridge": "workspace:*",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  }
}
