    { "id": 108, "guestName": "probe_six", "hostMethod": "probeSix", "parameters": [{ "name": "a", "type": "q16.16-raw-i32" }, { "name": "b", "type": "q16.16-raw-i32" }, { "name": "c", "type": "q16.16-raw-i32" }, { "name": "d", "type": "q16.16-raw-i32" }, { "name": "e", "type": "q16.16-raw-i32" }, { "name": "f", "type": "q16.16-raw-i32" }], "result": "integer" }
  ]
