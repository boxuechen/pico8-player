    { "id": 104, "guestName": "probe_pair", "hostMethod": "probePair", "parameters": [{ "name": "a", "type": "q16.16-raw-i32" }, { "name": "b", "type": "q16.16-raw-i32" }], "result": "void" },
    { "id": 105, "guestName": "probe_optional_tail", "hostMethod": "probeOptionalTail", "parameters": [{ "name": "a", "type": "q16.16-raw-i32" }, { "name": "b", "type": "q16.16-raw-i32", "optional": true }, { "name": "c", "type": "q16.16-raw-i32", "optional": true }], "result": "void" },
    { "id": 106, "guestName": "probe_integer", "hostMethod": "probeInteger", "parameters": [], "result": "integer" },
