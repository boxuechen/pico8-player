{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pico8-web-player.invalid/spec/compat/expanded-smoke-aggregate-v1.schema.json",
  "title": "Aggregate-only expanded PICO-8 Chrome smoke report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runner",
    "targetRuntime",
    "corpusFingerprint",
    "sourceRevision",
    "environment",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runner": { "const": "phase-8-expanded-smoke-v1" },
    "targetRuntime": { "const": "PICO-8 v0.2.7" },
    "corpusFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "playerCommit", "runtimeWasmSha256", "chromeVersion"],
      "properties": {
        "target": { "const": "chrome-production" },
        "playerCommit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "runtimeWasmSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "chromeVersion": { "type": "string", "pattern": "^(Google Chrome|Chromium) [0-9]" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseCount",
        "completedCaseCount",
        "smokeOutcomes",
        "counts",
        "failureClusters",
        "framebuffer",
        "screenshots",
        "resources"
      ],
      "properties": {
        "caseCount": { "const": 100 },
        "completedCaseCount": { "const": 100 },
        "smokeOutcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["boots", "fails", "notRun"],
          "properties": {
            "boots": { "type": "integer", "minimum": 0, "maximum": 100 },
            "fails": { "type": "integer", "minimum": 0, "maximum": 100 },
            "notRun": { "const": 0 }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["C0", "C1", "C2", "C3", "CU"],
          "properties": {
            "C0": { "type": "integer", "minimum": 0, "maximum": 100 },
            "C1": { "type": "integer", "minimum": 0, "maximum": 100 },
            "C2": { "type": "integer", "minimum": 0, "maximum": 100 },
            "C3": { "type": "integer", "minimum": 0, "maximum": 100 },
            "CU": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "failureClusters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parse",
            "language",
            "ram",
            "graphics",
            "audio",
            "input",
            "timing",
            "persistence",
            "multicart",
            "unsupported-host-feature"
          ],
          "properties": {
            "parse": { "type": "integer", "minimum": 0, "maximum": 100 },
            "language": { "type": "integer", "minimum": 0, "maximum": 100 },
            "ram": { "type": "integer", "minimum": 0, "maximum": 100 },
            "graphics": { "type": "integer", "minimum": 0, "maximum": 100 },
            "audio": { "type": "integer", "minimum": 0, "maximum": 100 },
            "input": { "type": "integer", "minimum": 0, "maximum": 100 },
            "timing": { "type": "integer", "minimum": 0, "maximum": 100 },
            "persistence": { "type": "integer", "minimum": 0, "maximum": 100 },
            "multicart": { "type": "integer", "minimum": 0, "maximum": 100 },
            "unsupported-host-feature": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "framebuffer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["withFrame", "nonBlack", "blackOnly"],
          "properties": {
            "withFrame": { "type": "integer", "minimum": 0, "maximum": 100 },
            "nonBlack": { "type": "integer", "minimum": 0, "maximum": 100 },
            "blackOnly": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "screenshots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["captured", "missing"],
          "properties": {
            "captured": { "const": 100 },
            "missing": { "const": 0 }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completedBatchRuns", "infrastructureFailures"],
          "properties": {
            "completedBatchRuns": { "const": 2 },
            "infrastructureFailures": { "const": 0 }
          }
        }
      }
    }
  }
}
