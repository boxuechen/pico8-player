{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pico8-web-player.invalid/spec/compat/local-corpus-v1.schema.json",
  "title": "Local external PICO-8 corpus manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "policy", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "corpusId": { "$ref": "#/$defs/id" },
    "policy": { "const": "developer-supplied-local-only" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "file",
        "sha256",
        "pico8Version",
        "source",
        "trace"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "file": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pico8Version": { "const": "0.2.7" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "revision", "permissionStatus", "permissionBasis"],
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 128 },
            "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
            "permissionStatus": {
              "enum": [
                "caller-authorized-local-research",
                "licensed-local-test",
                "author-provided"
              ]
            },
            "permissionBasis": { "type": "string", "minLength": 1, "maxLength": 512 },
            "url": { "type": "string", "minLength": 1, "maxLength": 2048 }
          }
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "ticks", "stepMilliseconds", "inputs"],
          "properties": {
            "mode": { "const": "fixed-ticks" },
            "ticks": { "type": "integer", "minimum": 1, "maximum": 36000 },
            "stepMilliseconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "inputs": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tick", "player", "button", "pressed"],
                "properties": {
                  "tick": { "type": "integer", "minimum": 0, "maximum": 35999 },
                  "player": { "type": "integer", "minimum": 0, "maximum": 7 },
                  "button": { "type": "integer", "minimum": 0, "maximum": 5 },
                  "pressed": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    }
  }
}
