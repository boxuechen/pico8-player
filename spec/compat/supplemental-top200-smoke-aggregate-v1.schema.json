{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pico8-web-player.invalid/spec/compat/supplemental-top200-smoke-aggregate-v1.schema.json",
  "title": "Aggregate-only supplemental Top 200 Chrome smoke report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runner", "targetRuntime", "corpusFingerprint", "sourceSnapshot", "formalPhase8DenominatorChanged", "environment", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runner": { "const": "phase-8f-supplemental-top200-smoke-v1" },
    "targetRuntime": { "const": "PICO-8 v0.2.7" },
    "corpusFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceSnapshot": { "type": "string", "minLength": 1 },
    "formalPhase8DenominatorChanged": { "const": false },
    "environment": { "$ref": "local-observations-v1.schema.json#/properties/environment" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseCount", "completedCaseCount", "smokeOutcomes", "counts", "failureClusters", "framebuffer", "screenshots", "resources"],
      "properties": {
        "caseCount": { "const": 200 },
        "completedCaseCount": { "const": 200 },
        "smokeOutcomes": { "$ref": "#/$defs/outcomes" },
        "counts": { "$ref": "#/$defs/counts" },
        "failureClusters": { "$ref": "#/$defs/clusters" },
        "framebuffer": { "$ref": "#/$defs/framebuffer" },
        "screenshots": { "$ref": "#/$defs/screenshots" },
        "resources": { "$ref": "#/$defs/resources" }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 200 },
    "outcomes": {
      "type": "object", "additionalProperties": false,
      "required": ["boots", "fails", "notRun"],
      "properties": { "boots": { "$ref": "#/$defs/count" }, "fails": { "$ref": "#/$defs/count" }, "notRun": { "const": 0 } }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["C0", "C1", "C2", "C3", "CU"],
      "properties": { "C0": { "$ref": "#/$defs/count" }, "C1": { "$ref": "#/$defs/count" }, "C2": { "$ref": "#/$defs/count" }, "C3": { "$ref": "#/$defs/count" }, "CU": { "$ref": "#/$defs/count" } }
    },
    "clusters": {
      "type": "object", "additionalProperties": false,
      "required": ["parse", "language", "ram", "graphics", "audio", "input", "timing", "persistence", "unsupported-host-feature"],
      "properties": {
        "parse": { "$ref": "#/$defs/count" }, "language": { "$ref": "#/$defs/count" },
        "ram": { "$ref": "#/$defs/count" }, "graphics": { "$ref": "#/$defs/count" },
        "audio": { "$ref": "#/$defs/count" }, "input": { "$ref": "#/$defs/count" },
        "timing": { "$ref": "#/$defs/count" }, "persistence": { "$ref": "#/$defs/count" },
        "unsupported-host-feature": { "$ref": "#/$defs/count" }
      }
    },
    "framebuffer": {
      "type": "object", "additionalProperties": false,
      "required": ["withFrame", "nonBlack", "blackOnly"],
      "properties": { "withFrame": { "$ref": "#/$defs/count" }, "nonBlack": { "$ref": "#/$defs/count" }, "blackOnly": { "$ref": "#/$defs/count" } }
    },
    "screenshots": {
      "type": "object", "additionalProperties": false,
      "required": ["captured", "missing"],
      "properties": { "captured": { "const": 200 }, "missing": { "const": 0 } }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["completedBatchRuns", "infrastructureFailures"],
      "properties": { "completedBatchRuns": { "const": 4 }, "infrastructureFailures": { "const": 0 } }
    }
  }
}
