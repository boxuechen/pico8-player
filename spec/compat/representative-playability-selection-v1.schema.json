{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pico8-web-player.invalid/spec/compat/representative-playability-selection-v1.schema.json",
  "title": "External-only Phase 8F representative playability selection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runner", "targetRuntime", "corpusFingerprint", "sourceRevision", "manifest", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "runner": { "const": "phase-8f-representative-playability-v1" },
    "targetRuntime": { "const": "PICO-8 v0.2.7" },
    "corpusFingerprint": { "$ref": "#/$defs/sha256" },
    "sourceRevision": { "type": "string", "minLength": 1 },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "cases", "sha256"],
      "properties": {
        "file": { "const": "representative-playability-manifest.json" },
        "cases": { "const": 10 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "entries": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "risks", "gate", "criticalFlow", "mainVerbs", "audio", "persistence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$" },
        "risks": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["graphics", "audio", "input", "persistence", "multicart", "complex-flow"] }
        },
        "gate": { "enum": ["critical-flow", "duration"] },
        "criticalFlow": { "type": "string", "minLength": 1, "maxLength": 512 },
        "mainVerbs": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "audio": { "enum": ["pass", "known-minor-difference", "not-applicable"] },
        "persistence": { "enum": ["pass", "not-applicable"] }
      }
    }
  }
}
