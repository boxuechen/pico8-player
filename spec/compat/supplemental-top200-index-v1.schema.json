{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pico8-web-player.invalid/spec/compat/supplemental-top200-index-v1.schema.json",
  "title": "External-only supplemental Top 200 corpus index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runner", "targetRuntime", "corpusFingerprint", "source", "cases", "batches"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "runner": { "const": "phase-8f-supplemental-top200-corpus-v1" },
    "targetRuntime": { "const": "PICO-8 v0.2.7" },
    "corpusFingerprint": { "$ref": "#/$defs/sha256" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "rankingWindow", "pageDataDate", "inventorySha256", "localOnly", "redistributionAuthorized"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "rankingWindow": { "type": "string", "minLength": 1 },
        "pageDataDate": { "type": "string", "minLength": 1 },
        "inventorySha256": { "$ref": "#/$defs/sha256" },
        "localOnly": { "const": true },
        "redistributionAuthorized": { "const": false }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 200,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/case" }
    },
    "batches": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/batch" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rank", "file", "byteLength", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^phase8f/top200/case-[0-9]{3}$" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 200 },
        "file": { "type": "string", "pattern": "^carts/case-[0-9]{3}\\.p8\\.png$" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "cases", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^top200-batch-[0-9]{2}\\.json$" },
        "cases": { "const": 50 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
