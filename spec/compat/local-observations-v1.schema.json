{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pico8-web-player.invalid/spec/compat/local-observations-v1.schema.json",
  "title": "Local external PICO-8 observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "playerCommit", "runtimeWasmSha256", "chromeVersion"],
      "properties": {
        "target": { "const": "chrome-production" },
        "playerCommit": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "runtimeWasmSha256": { "$ref": "#/$defs/sha256" },
        "chromeVersion": {
          "type": "string",
          "pattern": "^(Google Chrome|Chromium) [0-9]"
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/observation" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "completed",
        "smokeOutcome",
        "classification",
        "failureCluster",
        "completedTicks"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$" },
        "completed": { "type": "boolean" },
        "smokeOutcome": { "enum": ["boots", "fails", "not-run"] },
        "classification": { "enum": ["C0", "C1", "C2", "C3", "CU"] },
        "failureCluster": {
          "type": ["string", "null"],
          "enum": [
            "parse",
            "language",
            "ram",
            "graphics",
            "audio",
            "input",
            "timing",
            "persistence",
            "unsupported-host-feature",
            null
          ]
        },
        "completedTicks": { "type": "integer", "minimum": 0, "maximum": 36000 },
        "faultCode": { "type": "string", "minLength": 1, "maxLength": 128 },
        "faultMessage": { "type": "string", "minLength": 1, "maxLength": 512 },
        "frameCount": { "type": "integer", "minimum": 0, "maximum": 36000 },
        "screenSha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "nonBlackPixels": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "distinctColors": { "type": "integer", "minimum": 0, "maximum": 256 },
        "screenshotCaptured": { "type": "boolean" },
        "expectedTerminationMatched": { "type": "boolean" },
        "playability": { "$ref": "#/$defs/playability" }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "C2" } } },
          "then": { "required": ["playability"] },
          "else": { "not": { "required": ["playability"] } }
        },
        {
          "if": {
            "required": ["expectedTerminationMatched"],
            "properties": { "expectedTerminationMatched": { "const": true } }
          },
          "then": {
            "required": ["faultCode"],
            "properties": {
              "classification": { "const": "CU" },
              "smokeOutcome": { "const": "fails" },
              "failureCluster": { "const": null }
            }
          }
        },
        {
          "if": {
            "properties": {
              "classification": { "const": "CU" },
              "smokeOutcome": { "const": "fails" }
            },
            "required": ["classification", "smokeOutcome"]
          },
          "then": {
            "required": ["expectedTerminationMatched"],
            "properties": { "expectedTerminationMatched": { "const": true } }
          }
        }
      ]
    },
    "playability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "durationSeconds",
        "criticalFlow",
        "criticalFlowCompleted",
        "mainVerbs",
        "input",
        "visual",
        "audio",
        "persistence",
        "crashFree",
        "softLockFree",
        "reviewedAt",
        "reviewer",
        "evidenceSha256"
      ],
      "properties": {
        "gate": { "enum": ["duration", "critical-flow"] },
        "durationSeconds": { "type": "integer", "minimum": 0, "maximum": 36000 },
        "criticalFlow": { "type": "string", "minLength": 1, "maxLength": 512 },
        "criticalFlowCompleted": { "type": "boolean" },
        "mainVerbs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "input": { "enum": ["pass", "not-applicable"] },
        "visual": { "enum": ["pass", "known-minor-difference"] },
        "audio": { "enum": ["pass", "known-minor-difference", "not-applicable"] },
        "persistence": { "enum": ["pass", "not-applicable"] },
        "crashFree": { "const": true },
        "softLockFree": { "const": true },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
