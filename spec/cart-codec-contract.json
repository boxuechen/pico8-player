{
  "schemaVersion": 1,
  "target": {
    "pico8Version": "0.2.7",
    "maximumCartVersion": 42
  },
  "formats": ["p8", "p8.png"],
  "parsedCart": {
    "requiredFields": ["identity", "format", "version", "rom", "code", "warnings", "sourceBytes"],
    "identity": {
      "field": "contentSha256",
      "algorithm": "SHA-256",
      "input": "exact caller-provided bytes",
      "encoding": "lower-case hexadecimal"
    },
    "romBytes": 32768,
    "codeEncoding": "P8SCII bytes",
    "compatibilityAliases": {
      "cartVersion": "version",
      "luaSource": "code"
    },
    "ownership": "frozen records and independent caller-owned typed-array snapshots"
  },
  "text": {
    "headerPrefix": "pico-8 cartridge",
    "bom": "optional UTF-8 BOM",
    "lineEndings": ["lf", "crlf", "mixed"],
    "sections": ["lua", "gfx", "gff", "map", "sfx", "music", "label"],
    "unknownSection": "warning-and-ignore",
    "duplicateKnownSection": "error",
    "rows": {
      "gfx": { "maximum": 128, "characters": 128, "encoding": "hex pixel nibbles, low nibble first" },
      "gff": { "maximum": 2, "characters": 256, "encoding": "hex bytes" },
      "map": { "maximum": 64, "characters": 256, "encoding": "hex bytes; rows 32..63 OR into gfx2" },
      "sfx": { "maximum": 64, "characters": 168, "encoding": "8 metadata hex chars plus 32 five-hex-character notes" },
      "music": { "maximum": 64, "characters": 11, "encoding": "2 flag hex chars, space, 4 channel bytes" },
      "label": { "maximum": 128, "characters": 128, "encoding": "base32 palette indices; validation only" }
    },
    "defaultLimits": {
      "maximumInputBytes": 1048576,
      "maximumCodeBytes": 65535,
      "maximumLines": 32768,
      "maximumCartVersion": 42
    },
    "includeWithoutResolver": "E_CART_INCLUDE_UNRESOLVED",
    "diagnosticOffsets": "original input byte offsets including optional BOM and CRLF bytes"
  },
  "png": {
    "width": 160,
    "height": 205,
    "bitDepth": 8,
    "colorType": 6,
    "compressionMethod": 0,
    "filterMethod": 0,
    "interlaceMethod": 0,
    "filters": [0, 1, 2, 3, 4]
  },
  "payload": {
    "totalBytes": 32800,
    "usedBytes": 32769,
    "romBytes": 32768,
    "codeOffset": 17152,
    "codeBlockBytes": 15616,
    "versionOffset": 32768,
    "reservedBytes": 31,
    "channelOrder": "ARGB significance from RGBA byte input",
    "extraction": "((a & 3) << 6) | ((r & 3) << 4) | ((g & 3) << 2) | (b & 3)"
  },
  "codeCompression": ["raw", "legacy", "pxa"],
  "defaultLimits": {
    "maximumInputBytes": 1048576,
    "maximumChunks": 128,
    "maximumIdatBytes": 262144,
    "maximumInflatedBytes": 131405,
    "maximumCodeBytes": 65535,
    "maximumCartVersion": 42
  },
  "errorCodes": [
    "E_CART_ARGUMENT",
    "E_CART_LIMITS",
    "E_CART_INPUT_TOO_LARGE",
    "E_CART_FORMAT",
    "E_CART_TEXT_HEADER",
    "E_CART_TEXT_VERSION",
    "E_CART_TEXT_LINE_ENDING",
    "E_CART_TEXT_ENCODING",
    "E_CART_TEXT_SECTION",
    "E_CART_TEXT_ROW",
    "E_CART_TEXT_CAPACITY",
    "E_CART_INCLUDE_UNRESOLVED",
    "E_CART_PNG_SIGNATURE",
    "E_CART_PNG_TRUNCATED",
    "E_CART_PNG_CHUNK_LIMIT",
    "E_CART_PNG_CHUNK_LENGTH",
    "E_CART_PNG_CRC",
    "E_CART_PNG_ORDER",
    "E_CART_PNG_CRITICAL_CHUNK",
    "E_CART_PNG_IHDR",
    "E_CART_PNG_DIMENSIONS",
    "E_CART_PNG_FORMAT",
    "E_CART_PNG_IDAT_LIMIT",
    "E_CART_PNG_ZLIB",
    "E_CART_PNG_DEFLATE",
    "E_CART_PNG_INFLATE_LIMIT",
    "E_CART_PNG_FILTER",
    "E_CART_PAYLOAD",
    "E_CART_FUTURE_VERSION",
    "E_CART_CODE_CORRUPT",
    "E_CART_CODE_TOO_LARGE"
  ]
}
